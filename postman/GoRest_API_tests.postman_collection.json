	"item": [
		{
			"name": "POST /users - Create new user",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const timestamp = Date.now();\r",
							"const randomEmail = `test.user.${timestamp}@example.com`;\r",
							"\r",
							"pm.environment.set(\"timestamp\", timestamp);\r",
							"pm.environment.set(\"random_email\", randomEmail);\r",
							"\r",
							"console.log(\"Generated email: \" + randomEmail);"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"const responseJson = pm.response.json();\r",
							"\r",
							"utils.assertStatus(pm, 201, \"Created\");\r",
							"utils.assertSla(pm);\r",
							"\r",
							"pm.test(\"Response body contains created user details\", function () {\r",
							"    pm.expect(responseJson).to.have.property('id');\r",
							"    pm.expect(responseJson).to.have.property('name');\r",
							"    pm.expect(responseJson).to.have.property('email');\r",
							"    pm.expect(responseJson).to.have.property('status');\r",
							"    pm.expect(responseJson.email).to.eql(pm.environment.get(\"random_email\"));\r",
							"    pm.expect(responseJson.status).to.eql(\"active\");\r",
							"});\r",
							"\r",
							"pm.environment.set(\"user_id\", responseJson.id);"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"name\": \"Test User {{timestamp}}\",\r\n    \"email\": \"{{random_email}}\",\r\n    \"gender\": \"female\",\r\n    \"status\": \"active\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/users",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"users"
					]
				}
			},
			"response": []
		},
		{
			"name": "GET /users/:id - Fetch user details",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"utils.assertStatus(pm, 200, \"OK\");\r",
							"\r",
							"const responseJson = pm.response.json();\r",
							"\r",
							"pm.test(\"Response data matches created user properties\", function () {\r",
							"    pm.expect(responseJson.id).to.eql(pm.environment.get(\"user_id\"));\r",
							"    pm.expect(responseJson.email).to.eql(pm.environment.get(\"random_email\"));\r",
							"    pm.expect(responseJson.name).to.include(\"Test User\");\r",
							"});\r",
							"\r",
							"pm.test(\"Response contains all required user fields\", function () {\r",
							"    const requiredFields = [\"id\", \"name\", \"email\", \"gender\", \"status\"];\r",
							"\r",
							"    requiredFields.forEach(field => {\r",
							"        pm.expect(responseJson).to.have.property(field);\r",
							"    });\r",
							"});\r",
							"\r",
							"pm.test(\"Response structure conforms to JSON Schema\", function () {\r",
							"    const userSchema = {\r",
							"        \"type\": \"object\",\r",
							"        \"required\": [\"id\", \"name\", \"email\", \"gender\", \"status\"],\r",
							"        \"properties\": {\r",
							"            \"id\": { \"type\": \"integer\" },\r",
							"            \"name\": { \"type\": \"string\" },\r",
							"            \"email\": { \"type\": \"string\" },\r",
							"            \"gender\": { \"type\": \"string\" },\r",
							"            \"status\": { \"type\": \"string\" }\r",
							"        }\r",
							"    };\r",
							"    pm.response.to.have.jsonSchema(userSchema);\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"utils.requireUserId(pm);\r",
							"console.log(\"Fetching user: \" + pm.environment.get(\"user_id\"));"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/users/{{user_id}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"users",
						"{{user_id}}"
					]
				}
			},
			"response": []
		},
		{
			"name": "POST /posts - Create user post",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"utils.assertStatus(pm, 201, \"Created\");\r",
							"utils.assertSla(pm);\r",
							"\r",
							"const responseJson = pm.response.json();\r",
							"\r",
							"pm.test(\"Post is correctly linked to existing user ID\", function () {\r",
							"    pm.expect(responseJson.user_id).to.eql(parseInt(pm.environment.get(\"user_id\")));\r",
							"    pm.environment.set(\"test_post_id\", responseJson.id);\r",
							"    console.log(\"Created post ID: \" + responseJson.id);\r",
							"});\r",
							"\r",
							"pm.test(\"Post title matches requested value\", function () {\r",
							"    pm.expect(responseJson.title).to.include(\"Nice\");\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"utils.requireUserId(pm);\r",
							"console.log(\"Creating post for user: \" + pm.environment.get(\"user_id\"));"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"title\": \"Nice post\",\r\n    \"body\": \"This is a test post created via API automation testing.\",\r\n    \"user_id\": {{user_id}}\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/posts",
