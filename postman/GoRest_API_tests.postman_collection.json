	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"exec": [
					"utils = {\r",
					"    assertStatus: function (pmCtx, statusCode, statusText) {\r",
					"        pmCtx.test(`Status code is ${statusCode} ${statusText}`, function () {\r",
					"            pmCtx.response.to.have.status(statusCode);\r",
					"        });\r",
					"    },\r",
					"    assertSla: function (pmCtx, maxMs) {\r",
					"        const threshold = maxMs || parseInt(pmCtx.environment.get(\"max_response_time_ms\")) || 2000;\r",
					"        pmCtx.test(`Response time is below ${threshold}ms SLA`, function () {\r",
					"            pmCtx.expect(pmCtx.response.responseTime).to.be.below(threshold);\r",
					"        });\r",
					"    },\r",
					"    requireUserId: function (pmCtx) {\r",
					"        const userId = pmCtx.environment.get(\"user_id\");\r",
					"        if (!userId) {\r",
					"            throw new Error(\"User ID not found. Need to create user first\");\r",
					"        }\r",
					"        return userId;\r",
					"    }\r",
					"};"
				]
			}
		},
