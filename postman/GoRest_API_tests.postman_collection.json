		{
			"name": "POST /users - Reject duplicate email registration",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"utils.assertStatus(pm, 422, \"Unprocessable Entity\");\r",
							"\r",
							"const responseJson = pm.response.json();\r",
							"\r",
							"pm.test(\"Validation error specifies duplicate email error\", function () {\r",
							"    pm.expect(responseJson).to.be.an(\"array\");\r",
							"    pm.expect(responseJson[0].field).to.eql(\"email\");\r",
							"    pm.expect(responseJson[0].message).to.eql(\"has already been taken\");\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
